{
  "name": "@greekgift/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-engine.mjs && next dev",
    "build": "node scripts/prepare-engine.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "env:check": "tsx --env-file-if-exists=.env.local src/env-check.ts",
    "prepare:engine": "node scripts/prepare-engine.mjs"
  },
  "dependencies": {
    "@greekgift/db": "workspace:*",
    "@greekgift/email": "workspace:*",
    "@greekgift/engine": "workspace:*",
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.7.2",
    "chess.js": "^1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stockfish": "18.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4",
    "@greekgift/coach": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
