# Copy to apps/web/.env.local and fill in. Every one is required.
# The placeholder values below are enough to run `pnpm dev` with no accounts:
# DATABASE_URL points at PGlite (local Postgres, no server) and the Brevo key
# is recognised as unset, which prints emails to the terminal instead.

# --- database -----------------------------------------------------------
# Local:      pglite://.pglite
# Production: postgres://user:pass@host/db  (Neon)
DATABASE_URL=pglite://.pglite

# --- auth ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated. These addresses become admins on first sign-in.
ADMIN_EMAILS=you@example.com

# --- email --------------------------------------------------------------
# Leave the placeholder to print emails to the terminal instead of sending.
BREVO_API_KEY=xkeysib-placeholder
EMAIL_FROM=greekgift@example.com

# --- client -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Nodes per position. Measured in-browser: one worker runs ~240k nodes/sec,
# so 1,000,000 would be 336s for an 80-position game. At 300k across 4 workers
# it is 35s, still depth ~15-16 — far past what a club game needs.
# This value is part of the eval cache key: changing it invalidates stored evals.
NEXT_PUBLIC_ENGINE_NODES=300000
# Also part of the cache key. Must match the build in public/engine.
NEXT_PUBLIC_ENGINE_BUILD=stockfish-18-lite-single
